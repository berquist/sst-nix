+ * event set, which PAPI_accum reads into the accumulators.
  */
 typedef long long dumpi_papi_accum_t;
 
+typedef struct dumpi_papi_thread_t {
+  int eventset;
+  dumpi_papi_accum_t accum[DUMPI_MAX_PERFCTRS];
+} dumpi_papi_thread_t;
