+static dumpi_papi_thread_t* start_thread_counters(void) {
+  int ret;
+  dumpi_papi_thread_t *state =
+    (dumpi_papi_thread_t*)calloc(1, sizeof(dumpi_papi_thread_t));
+  assert(state != NULL);
+  state->eventset = PAPI_NULL;
+  if((ret = PAPI_create_eventset(&state->eventset)) != PAPI_OK ||
+     (ret = PAPI_add_events(state->eventset, papi_code_, active_counters_))
+       != PAPI_OK ||
+     (ret = PAPI_start(state->eventset)) != PAPI_OK) {
+    fprintf(stderr, "Failed to start PAPI counters: %s\n", PAPI_strerror(ret));
+    free(state);
+    return NULL;
+  }
+  return state;
+}
